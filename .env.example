BOT_TOKEN=token_from_BotFather
AIMLAPI_KEY=aimlapi_key
AIMLAPI_URL=https://api.aimlapi.com/v1/chat/completions
BOT_MODE=polling

# PostgreSQL — used everywhere (locally and on Railway)
#
# Locally: Postgres on Railway → Connect → Public Network → Database URL
DATABASE_URL=postgresql://postgres:PASSWORD@xxxx.railway.app:5432/railway
#
# On Railway: bot service Variables → Add Reference → DATABASE_PRIVATE_URL
# DATABASE_PRIVATE_URL=postgresql://postgres:...@postgres.railway.internal:5432/railway

# optional
# CHAT_HISTORY_LIMIT=20
# AI_MODEL=openai/gpt-4.1-2025-04-14
