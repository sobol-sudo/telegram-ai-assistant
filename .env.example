BOT_TOKEN=123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AIMLAPI_KEY=your_aimlapi_key
AIMLAPI_URL=https://api.aimlapi.com/v1/chat/completions
BOT_MODE=polling

# PostgreSQL — на Railway: Add Reference → DATABASE_PRIVATE_URL
# DATABASE_URL=postgresql://user:password@localhost:5432/chatbot
# DATABASE_PRIVATE_URL=...

# optional
# CHAT_HISTORY_LIMIT=20

# optional — промпт редактируется в prompts/system.txt
# AI_SYSTEM_PROMPT_FILE=prompts/system.txt
# AI_SYSTEM_PROMPT=короткий промпт одной строкой (перебивает файл)
