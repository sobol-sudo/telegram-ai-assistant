BOT_TOKEN=токен_от_BotFather
AIMLAPI_KEY=ключ_aimlapi
AIMLAPI_URL=https://api.aimlapi.com/v1/chat/completions
BOT_MODE=polling

# PostgreSQL — везде (локально и Railway)
#
# Локально: Postgres на Railway → Connect → Public Network → Database URL
DATABASE_URL=postgresql://postgres:ПАРОЛЬ@xxxx.railway.app:5432/railway
#
# Railway: Variables сервиса бота → Add Reference → DATABASE_PRIVATE_URL
# DATABASE_PRIVATE_URL=postgresql://postgres:...@postgres.railway.internal:5432/railway

# optional
# CHAT_HISTORY_LIMIT=20
# AI_MODEL=openai/gpt-4.1-2025-04-14
